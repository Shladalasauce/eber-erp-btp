# Public Supabase project settings used by the browser application.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: enables the browser-side Gemini features.
# Browser-exposed keys must be restricted by API, origin, and quota.
VITE_GEMINI_API_KEY=your-restricted-gemini-api-key

# Server-side migration tools only. Never expose this value to the browser.
DATABASE_URL=postgresql://user:password@host:5432/database
